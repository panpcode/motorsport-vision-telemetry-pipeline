      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT ts, frame_idx, round(min_hazard_dist_m) AS distance_m, n_hazards,\n       arrayStringConcat(arrayDistinct(arrayMap(d -> JSONExtractString(d, 'cls'),\n           arrayFilter(d -> JSONExtractBool(d, 'hazard'), JSONExtractArrayRaw(detections)))), ', ') AS objects\nFROM motorsport.cv_events WHERE run_id = '${run_id}' AND $__timeFilter(ts) AND min_hazard_dist_m < 20 ORDER BY ts DESC LIMIT 50",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
