    {
      "id": 12,
      "type": "table",
      "title": "Hazard alerts (< 20 m)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
