          "refId": "A",
          "editorType": "sql",
          "rawSql": "SELECT corner AS C, round(apex_m) AS at_m, faster, round(abs(time_diff_s), 3) AS gain_s, why,\n       round(min_speed_a) AS min_kmh_${a}, round(min_speed_b) AS min_kmh_${b}\nFROM wrc.lap_corners WHERE comparison = '${comparison}' ORDER BY corner",
          "format": 1,
          "queryType": "table"
        }
