    {
      "id": 22,
      "type": "text",
      "title": "How to read this",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
