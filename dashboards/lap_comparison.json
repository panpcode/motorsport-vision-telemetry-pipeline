    {
      "id": 14,
      "type": "xychart",
      "title": "Faster per 200 m",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "refId": "A",
          "editorType": "sql",
          "rawSql": "WITH ms AS (\n    SELECT intDiv(toUInt32(distance_m), 200) AS m, argMax(delta_s, distance_m) - argMin(delta_s, distance_m) AS gain\n    FROM wrc.lap_grid WHERE comparison = '${comparison}' GROUP BY m)\nSELECT g.x AS x, g.y AS a_faster\nFROM wrc.lap_grid g JOIN ms ON intDiv(toUInt32(g.distance_m), 200) = ms.m\nWHERE g.comparison = '${comparison}' AND ms.gain > 0 ORDER BY g.distance_m",
          "format": 1,
          "queryType": "table"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "refId": "B",
          "editorType": "sql",
          "rawSql": "WITH ms AS (\n    SELECT intDiv(toUInt32(distance_m), 200) AS m, argMax(delta_s, distance_m) - argMin(delta_s, distance_m) AS gain\n    FROM wrc.lap_grid WHERE comparison = '${comparison}' GROUP BY m)\nSELECT g.x AS x, g.y AS b_faster\nFROM wrc.lap_grid g JOIN ms ON intDiv(toUInt32(g.distance_m), 200) = ms.m\nWHERE g.comparison = '${comparison}' AND ms.gain <= 0 ORDER BY g.distance_m",
          "format": 1,
          "queryType": "table"
        }
      ],
